{
  "$id": "agent-frontmatter.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Projection of the documented agent frontmatter fields (extensibility.agents.frontmatter in the knowledge file). The tools enum is cross-checked against the documented tool set by check_consistency.py so misspelled tool names (a documented cause of subagent hangs) are caught.",
  "properties": {
    "commandExecutionPolicy": {
      "default": "sandbox",
      "enum": [
        "off",
        "auto",
        "eager",
        "sandbox"
      ],
      "type": "string"
    },
    "description": {
      "description": "Used by planner for delegation",
      "type": "string"
    },
    "mainAgent": {
      "default": "true",
      "description": "Allow selection as primary agent in chat",
      "type": "boolean"
    },
    "mcpServers": {
      "default": "[]",
      "description": "Custom MCP servers for this subagent",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "model": {
      "default": "inherit",
      "enum": [
        "inherit",
        "flash",
        "pro"
      ],
      "type": "string"
    },
    "name": {
      "description": "Unique identifier",
      "type": "string"
    },
    "plugins": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "subagent": {
      "default": "true",
      "description": "Allow invocation via invoke_subagent",
      "type": "boolean"
    },
    "tools": {
      "default": "[]",
      "description": "Permitted tools (e.g. view_file, run_command)",
      "items": {
        "enum": [
          "ask_permission",
          "ask_question",
          "browser_click_element",
          "browser_drag_pixel_to_pixel",
          "browser_get_dom",
          "browser_get_network_request",
          "browser_input",
          "browser_list_network_requests",
          "browser_mouse_down",
          "browser_mouse_up",
          "browser_move_mouse",
          "browser_press_key",
          "browser_refresh_page",
          "browser_resize_window",
          "browser_scroll",
          "browser_scroll_dom",
          "browser_select_option",
          "browser_subagent",
          "call_mcp_tool",
          "capture_browser_console_logs",
          "capture_browser_screenshot",
          "click_browser_pixel",
          "command_status",
          "define_subagent",
          "delete_knowledge",
          "execute_browser_javascript",
          "find_by_name",
          "finish",
          "generate_image",
          "grep_search",
          "invoke_subagent",
          "list_browser_pages",
          "list_dir",
          "list_permissions",
          "list_resources",
          "manage_inbox",
          "manage_subagents",
          "manage_task",
          "multi_replace_file_content",
          "notebook_edit",
          "notebook_execution",
          "open_browser_url",
          "read_browser_page",
          "read_resource",
          "read_url_content",
          "replace_file_content",
          "run_command",
          "schedule",
          "search_web",
          "sed_file",
          "send_command_input",
          "send_message",
          "view_file",
          "wait",
          "wait_5_seconds",
          "write_to_file"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "title": "Antigravity CLI agent YAML frontmatter",
  "type": "object"
}
