{
  "$id": "settings.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Projection of the documented config_keys in the knowledge file (research/schema/antigravity-cli-knowledge.json). Regenerated by gen_schemas.py; cross-checked by check_consistency.py. Unknown keys are allowed: the knowledge base is deliberately permissive about undocumented keys.",
  "properties": {
    "adminPolicyPaths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "allowNonWorkspaceAccess": {
      "default": false,
      "type": "boolean"
    },
    "altScreenMode": {
      "default": "default",
      "enum": [
        "default",
        "always",
        "never"
      ],
      "type": "string"
    },
    "artifactReviewPolicy": {
      "default": "asks-for-review",
      "enum": [
        "asks-for-review",
        "agent-decides",
        "always-proceed"
      ],
      "type": "string"
    },
    "colorScheme": {
      "default": "terminal",
      "enum": [
        "light",
        "solarized light",
        "colorblind-friendly light",
        "dark",
        "solarized dark",
        "colorblind-friendly dark",
        "tokyo night",
        "terminal"
      ],
      "type": "string"
    },
    "editor": {
      "default": "auto",
      "enum": [
        "auto",
        "vim",
        "emacs",
        "nano",
        "<any binary>"
      ],
      "type": "string"
    },
    "editorMode": {
      "default": "default",
      "enum": [
        "default",
        "vim"
      ],
      "type": "string"
    },
    "enableTelemetry": {
      "default": true,
      "type": "boolean"
    },
    "enableTerminalSandbox": {
      "default": false,
      "type": "boolean"
    },
    "general": {
      "additionalProperties": true,
      "properties": {
        "openEditorInNewWindow": {
          "default": false,
          "type": "boolean"
        },
        "preferredEditor": {
          "default": "undefined",
          "enum": [
            "vscode",
            "vscodium",
            "windsurf",
            "cursor",
            "zed",
            "antigravity",
            "sublimetext",
            "lapce",
            "nova",
            "bbedit",
            "vim",
            "neovim",
            "emacs",
            "hx",
            "emacsclient",
            "micro"
          ],
          "type": "string"
        },
        "vimMode": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "model": {
      "type": "string"
    },
    "notifications": {
      "default": false,
      "type": "boolean"
    },
    "permissions": {
      "additionalProperties": true,
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ask": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "policyPaths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "runningLightSpeed": {
      "default": "medium",
      "enum": [
        "fast",
        "medium",
        "slow",
        "off"
      ],
      "type": "string"
    },
    "showFeedbackSurvey": {
      "default": true,
      "type": "boolean"
    },
    "showTips": {
      "default": true,
      "type": "boolean"
    },
    "statusLine": {
      "additionalProperties": true,
      "type": "object"
    },
    "title": {
      "additionalProperties": true,
      "type": "object"
    },
    "toolPermission": {
      "default": "request-review",
      "enum": [
        "request-review",
        "proceed-in-sandbox",
        "always-proceed",
        "strict"
      ],
      "type": "string"
    },
    "trustedWorkspaces": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ui": {
      "additionalProperties": true,
      "properties": {
        "footer": {
          "additionalProperties": true,
          "properties": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "language": {
          "default": "us",
          "type": "string"
        }
      },
      "type": "object"
    },
    "useG1Credits": {
      "default": false,
      "type": "boolean"
    },
    "verbosity": {
      "default": "high",
      "enum": [
        "high",
        "low"
      ],
      "type": "string"
    },
    "vimInsertFirst": {
      "default": false,
      "type": "boolean"
    }
  },
  "title": "Antigravity CLI settings.json",
  "type": "object"
}
