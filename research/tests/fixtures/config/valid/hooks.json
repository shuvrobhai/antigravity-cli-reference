{
  "my-linter-hook": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "./scripts/lint.sh", "timeout": 10 }
        ]
      }
    ]
  },
  "safety-gate": {
    "enabled": false,
    "PreToolUse": [
      { "matcher": "browser_.*", "hooks": [{ "command": "./scripts/safety-check.sh" }] }
    ],
    "Stop": [{ "matcher": "*", "hooks": [{ "command": "./scripts/cleanup.sh" }] }]
  }
}
